# Local Docker development (copy to .env.development; never commit it)
APP_ENV=development
LOG_LEVEL=INFO

# Compose sets this automatically for the api/worker/scheduler services.
DATABASE_URL=postgresql+psycopg://scanner:local_dev_password@postgres:5432/avwap_scanner
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DATABASE_REQUIRE_SSL=false

REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=dev-admin-key

# FYERS owner credentials (local only)
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8501
FYERS_BACKEND_REDIRECT_URI=http://localhost:8000/api/v1/fyers/callback
FYERS_TOKEN_FILE=/app/data/access_token.txt
FYERS_TOKEN_META_FILE=/app/data/token_meta.json
FYERS_CACHE_DIR=/app/data/cache
FYERS_LOG_DIR=/app/logs
FYERS_PRESETS_FILE=/app/data/presets.json

# Authentication development defaults
AUTH_SECRET_KEY=dev-insecure-secret-change-me-please-rotate-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=vwap-sentinel
JWT_AUDIENCE=vwap-sentinel-clients
COOKIE_SECURE=false
AUTH_DEV_EXPOSE_TOKENS=true
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@vwap-sentinel.local

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=56
SCHEDULER_TICK_SECONDS=15
WORKER_POLL_SECONDS=2
JOB_HEARTBEAT_TIMEOUT_SECONDS=900
SCAN_STALE_WARNING_HOURS=24
