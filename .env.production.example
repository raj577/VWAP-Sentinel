# Production environment (copy to .env.production; never commit it).
# Compose command:
#   docker compose --env-file .env.production -f compose.yaml -f compose.prod.yaml up -d
APP_ENV=production
LOG_LEVEL=INFO

# Neon PostgreSQL (pooled connection, SSL + channel binding enforced by URL).
# The backend replaces ${NEON_DB_PASSWORD} at runtime and URL-encodes it.
DATABASE_URL=postgresql+psycopg://neondb_owner:$${NEON_DB_PASSWORD}@ep-snowy-thunder-beeb113s-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DB_PASSWORD=
# Small pool for Neon pooled connections.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DATABASE_REQUIRE_SSL=true

REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=replace-with-a-long-random-service-key

# Public URLs (used by the web build and OAuth redirects)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
APP_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
FYERS_REDIRECT_URI=https://api.example.com/api/v1/fyers/callback
FYERS_BACKEND_REDIRECT_URI=https://api.example.com/api/v1/fyers/callback

# FYERS owner credentials (server-side only)
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_TOKEN_FILE=/app/data/access_token.txt
FYERS_TOKEN_META_FILE=/app/data/token_meta.json
FYERS_CACHE_DIR=/app/data/cache
FYERS_LOG_DIR=/app/logs
FYERS_PRESETS_FILE=/app/data/presets.json

# Authentication secrets (generate strong random values)
AUTH_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=vwap-sentinel
JWT_AUDIENCE=vwap-sentinel-clients
COOKIE_SECURE=true
AUTH_DEV_EXPOSE_TOKENS=false
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Email delivery
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# SUPER_ADMIN bootstrap (blank after creating the account)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=56
SCHEDULER_TICK_SECONDS=15
WORKER_POLL_SECONDS=2
JOB_HEARTBEAT_TIMEOUT_SECONDS=900
SCAN_STALE_WARNING_HOURS=24

# Image names for Docker Hub deployment
BACKEND_IMAGE=your-dockerhub-user/fyers-avwap-scanner-backend:latest
WEB_IMAGE=your-dockerhub-user/fyers-avwap-scanner-web:latest

# Ingest only the nearest active expiry per underlying\nINGEST_CURRENT_EXPIRY_ONLY=true

# Single-service free PaaS mode (Render/Koyeb): run loops inside the API process
RUN_WORKER_INPROCESS=false
RUN_SCHEDULER_INPROCESS=false
