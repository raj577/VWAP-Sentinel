# FYERS API credentials (never commit the real .env)
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8501

# Optional tuning
FYERS_TIMEZONE=Asia/Kolkata
FYERS_RESOLUTION=60
FYERS_HISTORY_CHUNK_DAYS=60
FYERS_CONTRACT_LOOKBACK_DAYS=120
# Keep 0 for an individual contract. 1 requests continuous futures, which
# would mix expiries and break contract-start AVWAP anchoring.
FYERS_HISTORY_CONT_FLAG=0
FYERS_HISTORY_CACHE_TTL=900
# Local JSON file for saved scanner presets
FYERS_PRESETS_FILE=presets/scanner_presets.json
FYERS_INSTRUMENT_CACHE_TTL=21600
FYERS_REQUEST_RATE_PER_SEC=5
FYERS_REQUEST_MAX_RETRIES=3
FYERS_INCLUDE_INDEX_FUTURES=false
FYERS_CHART_LOOKBACK=120
FYERS_LOG_LEVEL=INFO

# --- SaaS backend (Phase 1) ---
# PostgreSQL is the source of truth for the SaaS platform.
DATABASE_URL=postgresql+psycopg://avwap:avwap@127.0.0.1:5432/avwap
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# Automatic refresh interval in minutes (default 56).
SCHEDULER_INTERVAL_MINUTES=56

# Interim admin API key for Phase 2 diagnostics (replaced by JWT roles in Phase 5)
ADMIN_API_KEY=dev-admin-key

# Owner-level FYERS OAuth from the admin panel (register this exact URI in FYERS)
FYERS_BACKEND_REDIRECT_URI=http://localhost:8000/api/v1/fyers/callback
FRONTEND_BASE_URL=http://localhost:3000
FYERS_LOGIN_STATE_TTL=600

# --- Phase 4 scheduler / worker ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=56
MARKET_HOLIDAYS=
# Scheduled runs require an open market; manual runs can be blocked when false.
SCHEDULER_TICK_SECONDS=15
WORKER_POLL_SECONDS=2
JOB_HEARTBEAT_TIMEOUT_SECONDS=900
SCAN_STALE_WARNING_HOURS=24

# --- Phase 5 authentication ---
AUTH_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=vwap-sentinel
JWT_AUDIENCE=vwap-sentinel-clients
COOKIE_SECURE=false
AUTH_DEV_EXPOSE_TOKENS=true
APP_BASE_URL=http://localhost:3000
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Email delivery (console in development, smtp for real delivery)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@vwap-sentinel.local

# One-time SUPER_ADMIN bootstrap (leave blank after creating the account)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
